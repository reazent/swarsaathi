# Copy to .env and fill as you sign up (see docs/CLOUD-SETUP.md).
# The app reads only what it needs; unset integrations stay dormant.

# --- Core ---
APP_ENV=development
PRODUCT_NAME=Sargam
# Local dev (SQLite). Production: Neon/Supabase Postgres connection string.
DATABASE_URL=sqlite:///./data/indian_pitch.db
# Local: redis://localhost:6379/0 . Production: Upstash rediss:// URL.
REDIS_URL=redis://localhost:6379/0
AUDIO_DIR=audio
DATA_DIR=data

# --- Monetization (pitch) ---
FREE_DAILY_ANALYSES=5
PRO_CLIENT_IDS=

# --- Sargam (audio via Fal; keep model ids server-side only) ---
FAL_KEY=
# Music sketch / clip engine
FAL_MODEL_ID=fal-ai/stable-audio-3/medium/text-to-audio
STABILITY_MODEL_ID=stabilityai/stable-audio-3-medium
# Full-song engine (best → fallback):
# 1) Modal self-hosted ACE-Step v1.5 XL Turbo — modal deploy modal_apps/ace_step_song.py
# 2) Runware managed XL turbo — https://runware.ai → RUNWARE_API_KEY
# 3) WaveSpeed Ace-Step 1.5 — https://wavespeed.ai/accesskey → WAVESPEED_API_KEY
# 4) Fal classic ACE-Step (last resort) via FAL_KEY
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Audio fetch URL from `modal deploy` (sargam-ace-audio web function)
MODAL_ACE_AUDIO_URL=https://sumitv77--sargam-ace-audio.modal.run
RUNWARE_API_KEY=
RUNWARE_ACE_MODEL_ID=runware:ace-step@v1.5-xl-turbo
WAVESPEED_API_KEY=
WAVESPEED_ACE_MODEL_ID=wavespeed-ai/ace-step-1.5
FAL_ACE_MODEL_ID=fal-ai/ace-step
FAL_ACE_PROMPT_MODEL_ID=fal-ai/ace-step/prompt-to-audio
ACE_STEP_MODEL_REF=ACE-Step/acestep-v15-xl-turbo
# auto | modal | runware | wavespeed | fal
SARGAM_SONG_PROVIDER=auto
SARGAM_FREE_CREDITS=3
SARGAM_SECONDS_PER_CREDIT=30
SARGAM_MAX_DURATION_SEC=180
SARGAM_SONG_MAX_DURATION_SEC=240
SARGAM_PUBLIC_URL=https://swarsaathi.com/sargam/
# Optional JSON override for packs: [{"id":"starter","credits":20,"amount_cents":900,"label":"Starter · 20 credits"}]
SARGAM_CREDIT_PACKS_JSON=

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=swarsaathi-audio
R2_ENDPOINT_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Auth ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Billing ---
REVENUECAT_PUBLIC_KEY=
REVENUECAT_PUBLIC_KEY_IOS=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
RESEND_API_KEY=
RESEND_FROM=SwarSaathi <support@swarsaathi.com>
RESEND_DOMAIN_ID=

# --- Optional later GPU hosts ---
MODAL_TOKEN=
REPLICATE_API_TOKEN=
HF_TOKEN=

# --- CORS ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://swarsaathi.com,https://www.swarsaathi.com
